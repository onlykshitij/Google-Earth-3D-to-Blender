# Copy to .env beside docker-compose.yml and fill in what you need. Compose
# reads .env on its own, and git ignores it. Every value is optional.

# Port and address the interface is published on.
GMEB_HOST_PORT=8777
GMEB_BIND=127.0.0.1

# Shared secret Blender must present. Set it if the port is reachable from
# other machines: openssl rand -hex 24
GMEB_AGENT_TOKEN=

# CARTO basemaps key for the Dark and Light layers. Free, from
# https://carto.com/basemaps/apikey
GMEB_CARTO_KEY=

# An extra XYZ tile layer, shown as "Custom". For example:
# GMEB_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# GMEB_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
GMEB_TILE_URL=
GMEB_TILE_ATTRIBUTION=

# A Nominatim-compatible search. {query} is replaced by the search text.
# Empty uses the public nominatim.openstreetmap.org.
GMEB_GEOCODER_URL=
